{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NotificationsConnection": "Host=postgres;Database=Notifications;Username=postgres;Password=password123;",
    "DefaultConnection": "Host=postgres;Database=Notifications;Username=postgres;Password=password123;"
  },
  "RpcServerSettings": {
    "ExchangeName": "yourExchangeName",
    "QueueName": "yourQueueName",
    "RoutingKeys": [
      "RoutingKeys"
    ]
  },
  "RabbitMqSettings": {
    "HostName": "rabbitmq",
    "AutomaticRecoveryEnabled": true,
    "NetworkRecoveryInterval": "00:00:05"
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://elasticsearch:9200",
          "indexFormat": "elk-logs-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true,
          "minimumLogEventLevel": "Information"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
